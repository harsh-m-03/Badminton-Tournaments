<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/black"
    android:gravity="center|top"
    android:id="@+id/layout"
    android:orientation="vertical"
    android:padding="15dp"
    android:paddingTop="30dp"
    android:paddingBottom="20dp"
    tools:context=".Fragment.BottomSheets.TeamInfoBottomSheet">


    <TextView
        android:id="@+id/teamName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="left|top"
        android:fontFamily="@font/roboto_bold"
        android:text="Sample Name"
        android:textColor="@color/white"
        android:textSize="40sp" />

    <TextView
        android:id="@+id/gamePlayed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="left"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/roboto_bold"
        android:text="Played: "
        android:textColor="@color/off_white"
        android:textSize="25sp" />

    <TextView
        android:id="@+id/gameWon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="left"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/roboto_bold"
        android:text="Won: "
        android:textColor="@color/off_white"
        android:textSize="25sp" />

    <TextView
        android:id="@+id/gameLost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="left"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/roboto_bold"
        android:text="Lost: "
        android:textColor="@color/off_white"
        android:textSize="25sp" />

    <TextView
        android:id="@+id/winners"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="left"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/roboto_bold"
        android:text="Won Against: "
        android:textColor="@color/off_white"
        android:textSize="25sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/defeatAgainst"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="left"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/roboto_bold"
        android:text="Defeated: "
        android:textColor="@color/off_white"
        android:textSize="25sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/pastGame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="left"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/roboto_bold"
        android:text="History: "
        android:textColor="@color/off_white"
        android:textSize="25sp" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_weight="1"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/won"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="30dp"
            android:layout_weight=".5"
            android:background="@drawable/button_bg_2"
            android:backgroundTint="@color/green"
            android:elevation="2dp"
            android:fontFamily="@font/roboto_bold"
            android:paddingLeft="30dp"
            android:layout_marginRight="5dp"
            android:paddingRight="30dp"
            android:text="Add Victory"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/loss"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="30dp"
            android:layout_weight=".5"
            android:background="@drawable/button_bg_2"
            android:backgroundTint="@color/red"
            android:elevation="2dp"
            android:fontFamily="@font/roboto_bold"
            android:paddingLeft="30dp"
            android:paddingRight="30dp"
            android:text="Add Defeat"
            android:textColor="@color/white"
            android:textSize="16sp" />


    </LinearLayout>

</LinearLayout>